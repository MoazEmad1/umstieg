[Unit]
Description=Tell Telegram that the umstieg sync failed

[Service]
Type=oneshot
EnvironmentFile=/home/umstieg/umstieg/.env
ExecStart=/usr/bin/curl -fsS -o /dev/null https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage -d chat_id=${TELEGRAM_CHAT_ID} --data-urlencode "text=umstieg: daily sync failed, see journalctl -u umstieg-sync"
